# URL of the elevator-api service (default: http://localhost:8080)
NUXT_SERVICE_API_URL=http://localhost:8080

# Where elevator-auth issues tokens, and the client this BFF presents
# itself as. The technician's typed key-switch secret is that client's
# secret, so it lives in elevator-auth's configuration rather than here --
# this application holds no credential of its own.
NUXT_OAUTH_ISSUER=http://localhost:9000
NUXT_OAUTH_CLIENT_ID=elevator-technician
