# URL of the elevator-api service (default: http://localhost:8080)
NUXT_SERVICE_API_URL=http://localhost:8080

# Shared secret for technician key-switch actions. Must match
# TECHNICIAN_KEY on the elevator-api side. Dev default only -- not a
# real credential (mock physical key-switch access).
NUXT_PUBLIC_TECHNICIAN_KEY=dev-secret-key