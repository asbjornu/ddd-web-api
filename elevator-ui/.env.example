# URL of the elevator-api service (default: http://localhost:8080)
NUXT_SERVICE_API_URL=http://localhost:8080

# The client this BFF presents itself as when exchanging the technician's
# typed key-switch secret for a token; that secret is this client's own
# secret, so it lives in elevator-auth's configuration rather than here --
# this application holds no credential of its own. The issuer itself is
# not configured: it is discovered from elevator-api's own RFC 9728
# challenge.
NUXT_OAUTH_CLIENT_ID=elevator-technician
